generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  THERAPIST
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum TherapistVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum SessionFormat {
  VIDEO
  VOICE
  MESSAGING
}

enum SessionStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SlotStatus {
  AVAILABLE
  HELD
  BOOKED
  BLOCKED
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FLAGGED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model User {
  id                 String          @id @default(cuid())
  email              String          @unique
  passwordHash       String
  name               String?
  role               UserRole        @default(CLIENT)
  status             UserStatus      @default(ACTIVE)
  locale             String          @default("en-MA")
  timezone           String          @default("Africa/Casablanca")
  emailVerifiedAt    DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  therapistProfile   TherapistProfile?
  clientSessions     Session[]       @relation("ClientSessions")
  therapistSessions  Session[]       @relation("TherapistSessions")
  conversationsA     Conversation[] @relation("ConversationParticipantA")
  conversationsB     Conversation[] @relation("ConversationParticipantB")
  messages           Message[]
  subscriptions     Subscription[]
  consents           ConsentRecord[]
  auditEvents        AuditEvent[]

  @@index([role, status])
}

model TherapistProfile {
  id                 String                       @id @default(cuid())
  userId             String                       @unique
  title              String
  bio                String
  languages          String[]
  specialties        String[]
  formats            SessionFormat[]
  feeMad             Int
  verificationStatus TherapistVerificationStatus @default(PENDING)
  licenseAuthority   String?
  licenseReference   String?
  licenseExpiresAt   DateTime?
  verifiedAt         DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  user               User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots              AvailabilitySlot[]

  @@index([verificationStatus])
}

model AvailabilitySlot {
  id           String     @id @default(cuid())
  therapistId  String
  startsAt     DateTime
  endsAt       DateTime
  timezone     String     @default("Africa/Casablanca")
  status       SlotStatus @default(AVAILABLE)
  therapist    TherapistProfile @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  session      Session?

  @@unique([therapistId, startsAt, endsAt])
  @@index([therapistId, status, startsAt])
}

model Session {
  id            String        @id @default(cuid())
  clientId      String
  therapistId   String
  slotId        String        @unique
  format        SessionFormat
  status        SessionStatus @default(PENDING)
  feeMad        Int
  consentId     String?
  notes         String?
  startsAt      DateTime
  endsAt        DateTime
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  client        User          @relation("ClientSessions", fields: [clientId], references: [id])
  therapist     User          @relation("TherapistSessions", fields: [therapistId], references: [id])
  slot          AvailabilitySlot @relation(fields: [slotId], references: [id])
  consent       ConsentRecord? @relation(fields: [consentId], references: [id])

  @@index([clientId, startsAt])
  @@index([therapistId, startsAt])
}

model Conversation {
  id            String    @id @default(cuid())
  participantAId String
  participantBId String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  participantA  User      @relation("ConversationParticipantA", fields: [participantAId], references: [id])
  participantB  User      @relation("ConversationParticipantB", fields: [participantBId], references: [id])
  messages      Message[]

  @@unique([participantAId, participantBId])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  senderId       String
  ciphertext     String
  status         MessageStatus @default(SENT)
  createdAt      DateTime      @default(now())
  readAt         DateTime?
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User          @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  provider           String
  providerReference  String             @unique
  status             SubscriptionStatus
  planCode           String
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model ConsentRecord {
  id           String    @id @default(cuid())
  userId       String
  version      String
  purpose      String
  granted      Boolean
  grantedAt    DateTime  @default(now())
  withdrawnAt  DateTime?
  locale       String    @default("en-MA")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions     Session[]

  @@index([userId, purpose, grantedAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorId     String?
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  requestId   String?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}
